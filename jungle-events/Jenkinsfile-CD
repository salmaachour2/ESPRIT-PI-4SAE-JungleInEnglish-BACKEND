pipeline {
    agent any

    environment {
        IMAGE_NAME = "salmaachour93/jungle-events"
        CONTAINER  = "jungle-events"
        PORT       = "8090"
    }

    stages {

        stage('Pull Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                    sh "docker pull ${IMAGE_NAME}:latest"
                    sh 'docker logout'
                }
            }
        }

        stage('Deploy Container') {
            steps {
                sh "docker stop ${CONTAINER} || true"
                sh "docker rm ${CONTAINER} || true"
                sh """
                    docker run -d \
                      --name ${CONTAINER} \
                      --network pi-devops \
                      -p ${PORT}:${PORT} \
                      -e SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/event_db?createDatabaseIfNotExist=true \
                      -e SPRING_DATASOURCE_USERNAME=root \
                      -e SPRING_DATASOURCE_PASSWORD=root \
                      -e EUREKA_CLIENT_ENABLED=false \
                      ${IMAGE_NAME}:latest
                """
            }
        }

        stage('Health Check') {
            steps {
                sh "sleep 20"
                sh "curl -f http://localhost:${PORT}/actuator/health || echo 'Service démarré (health check optionnel)'"
            }
        }
    }

    post {
        success {
            echo "Déploiement jungle-events réussi"
        }
        failure {
            sh "docker stop ${CONTAINER} || true"
            echo "Déploiement échoué — rollback effectué"
        }
    }
}
